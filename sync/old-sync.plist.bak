<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jiang.baby-outfit-wxbot-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/jiang/Projects/baby-outfit-wxbot/sync/sync.py</string>
  </array>
  <key>StartInterval</key><integer>600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/jiang/Library/Logs/baby-outfit-wxbot-sync.log</string>
  <key>StandardErrorPath</key><string>/Users/jiang/Library/Logs/baby-outfit-wxbot-sync.log</string>
</dict>
</plist>
